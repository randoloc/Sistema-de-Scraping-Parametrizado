# Dockerfile para NovaSearch en HuggingFace Spaces
FROM python:3.11-slim

WORKDIR /app

# Instalar dependencias del sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copiar requirements e instalar
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copiar código del proyecto
COPY modulo_1_servicio/ modulo_1_servicio/
COPY adapters/ adapters/
COPY app.py .
COPY requirements.txt .
COPY README.md .

# Puerto que HF Spaces espera
EXPOSE 7860

# Iniciar con uvicorn (NovaSearch Gradio montado sobre FastAPI).
# La UI NovaSearch se sirve en "/" y la API REST en /api/* y /docs.
CMD ["uvicorn", "modulo_1_servicio.main:app", "--host", "0.0.0.0", "--port", "7860"]
