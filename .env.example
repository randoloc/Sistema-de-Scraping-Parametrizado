# Configuración del servicio de scraping (Módulo 1)
# Copiar como .env y completar

# --- WhatsApp Meta Cloud API ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=scrapper_generico_verify_2026
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- Email ---
# Opción 1: SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=scrapper@generico.dev

# Opción 2: SendGrid
USE_SENDGRID=false
SENDGRID_API_KEY=

# --- Servicio ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
